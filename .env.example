# Server-side only. Never prefix these with VITE_ — they must not reach the browser bundle.

# Gnani API platform key (app.gnani.ai → API keys). Used for Prisma STT and Timbre TTS.
GNANI_API_KEY=
# Optional overrides
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani

# Groq (console.groq.com → API keys). Used only for complex commands the local parser can't handle.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional: if set, API routes require header x-demo-token with this value.
DEMO_ACCESS_TOKEN=
